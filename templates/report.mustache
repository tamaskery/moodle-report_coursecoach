    @template report_coursecoach/report

    Course Readiness Coach report.

    Context variables required for this template:
    * score - Readiness score from 0 to 100.
    * readinesslabel - Overall readiness label.
    * readinessclass - Moodle-native badge colour class.
    * passedcount - Number of passed checks.
    * warningcount - Number of warning checks.
    * criticalcount - Number of critical checks.
    * assessedchecks - Localised assessed-check count.
    * hasissues - Whether issue results exist.
    * issues - Critical results followed by Warning results.
    * haspassedchecks - Whether Passed results exist.
    * passedchecks - Passed results in checker order.
    * hasnotapplicablechecks - Whether Not applicable results exist.
    * notapplicablechecks - Not applicable results in checker order.
    * hasdisabledchecks - Whether site configuration excludes checks.
    * disabledchecks - Titles of disabled checks, separate from evaluated results.
    * alldisabled - Whether every built-in check is disabled.
    * policysource - Optional plain-text description of the effective policy.
    * disabledheading - Heading distinguishing site and category exclusions.

    Example context (json):
    {
        "score": 70,
        "readinesslabel": "Needs attention",
        "readinessclass": "bg-warning text-dark",
        "passedcount": 2,
        "warningcount": 1,
        "criticalcount": 0,
        "assessedchecks": "3 of 10 checks assessed",
        "hasissues": true,
        "issues": [
            {
                "index": 1,
                "title": "Course completion configuration",
                "statusclass": "bg-warning text-dark",
                "statuslabel": "Warning",
                "explanation": "Completion is enabled but no criteria are configured.",
                "showrecommendation": true,
                "recommendation": "Add a meaningful course completion criterion.",
                "hassettingsurl": true,
                "settingsurl": "https://example.com/course/completion.php?id=2",
                "actionlabel": "Configure course completion"
            }
        ],
        "haspassedchecks": true,
        "passedchecks": [
            {
                "index": 2,
                "title": "Course visibility",
                "statusclass": "bg-success",
                "statuslabel": "Passed",
                "explanation": "The course is visible to learners."
            }
        ],
        "hasnotapplicablechecks": true,
        "notapplicablechecks": [
            {
                "index": 3,
                "title": "Quiz pass and completion",
                "statusclass": "bg-secondary text-dark",
                "statuslabel": "Not applicable",
                "explanation": "No applicable quizzes were found."
            }
        ]
    }
}}
<div class="report-coursecoach-report">
    <p class="lead">{{#str}} reportintro, report_coursecoach {{/str}}</p>
    {{#policysource}}<p>{{policysource}}</p>{{/policysource}}

    <section class="card mb-4" aria-labelledby="report-coursecoach-score-heading">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 id="report-coursecoach-score-heading" class="h4">
                        {{#str}} readinessscore, report_coursecoach {{/str}}
                    </h2>
                    <span class="badge {{readinessclass}}">{{readinesslabel}}</span>
                </div>
                <div class="display-4" aria-hidden="true">
                    {{score}}<span class="h4 text-muted">/100</span>
                </div>
            </div>
            <p class="mt-3 mb-1">{{assessedchecks}}</p>
            {{#alldisabled}}
                <p>{{#str}} alldisabled, report_coursecoach {{/str}}</p>
            {{/alldisabled}}
            <p class="text-muted mb-0">
                {{#str}} scoreexplanation, report_coursecoach {{/str}}
            </p>
            <div
                class="progress mt-3"
                role="progressbar"
                aria-label="{{#str}} readinessscore, report_coursecoach {{/str}}"
                aria-valuenow="{{score}}"
                aria-valuemin="0"
                aria-valuemax="100"
            >
                <div class="progress-bar {{readinessclass}}" style="width: {{score}}%"></div>
            </div>
        </div>
    </section>

    <section class="mb-4" aria-labelledby="report-coursecoach-summary-heading">
        <h2 id="report-coursecoach-summary-heading" class="h4">
            {{#str}} summary, report_coursecoach {{/str}}
        </h2>
        <div class="row g-3">
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="h3 mb-0">{{passedcount}}</div>
                        <div>{{#str}} passed, report_coursecoach {{/str}}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="h3 mb-0">{{warningcount}}</div>
                        <div>{{#str}} warnings, report_coursecoach {{/str}}</div>
                    </div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="h3 mb-0">{{criticalcount}}</div>
                        <div>{{#str}} criticalissues, report_coursecoach {{/str}}</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {{#hasissues}}
        <section class="mb-4" aria-labelledby="report-coursecoach-issues-heading">
            <h2 id="report-coursecoach-issues-heading" class="h4">
                {{#str}} needsattentionheading, report_coursecoach {{/str}}
            </h2>
            {{#issues}}
                <article class="card mb-3" aria-labelledby="report-coursecoach-check-{{index}}">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <h3 id="report-coursecoach-check-{{index}}" class="h5 mb-2">{{title}}</h3>
                            <span class="badge {{statusclass}}">{{statuslabel}}</span>
                        </div>
                        <p>{{explanation}}</p>
                        {{#showrecommendation}}
                            <h4 class="h6">{{#str}} recommendation, report_coursecoach {{/str}}</h4>
                            <p>{{recommendation}}</p>
                        {{/showrecommendation}}
                        {{#hassettingsurl}}
                            <a class="btn btn-primary" href="{{settingsurl}}">
                                {{actionlabel}}
                            </a>
                        {{/hassettingsurl}}
                    </div>
                </article>
            {{/issues}}
        </section>
    {{/hasissues}}

    {{#haspassedchecks}}
        <section class="mb-4" aria-labelledby="report-coursecoach-passed-heading">
            <h2 id="report-coursecoach-passed-heading" class="h4">
                {{#str}} passedchecksheading, report_coursecoach {{/str}}
            </h2>
            <div class="list-group">
                {{#passedchecks}}
                    <article class="list-group-item" aria-labelledby="report-coursecoach-check-{{index}}">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <h3 id="report-coursecoach-check-{{index}}" class="h5 mb-1">{{title}}</h3>
                            <span class="badge {{statusclass}}">{{statuslabel}}</span>
                        </div>
                        <p class="mb-0">{{explanation}}</p>
                    </article>
                {{/passedchecks}}
            </div>
        </section>
    {{/haspassedchecks}}

    {{#hasdisabledchecks}}
        <section class="mb-4" aria-labelledby="report-coursecoach-disabled-heading">
            <h2 id="report-coursecoach-disabled-heading" class="h4">
                {{disabledheading}}
            </h2>
            <p>{{#str}} disabledchecks_desc, report_coursecoach {{/str}}</p>
            <ul>
                {{#disabledchecks}}
                    <li>{{title}}</li>
                {{/disabledchecks}}
            </ul>
        </section>
    {{/hasdisabledchecks}}

    {{#hasnotapplicablechecks}}
        <section class="mb-4" aria-labelledby="report-coursecoach-not-applicable-heading">
            <h2 id="report-coursecoach-not-applicable-heading" class="h4">
                {{#str}} notapplicablechecksheading, report_coursecoach {{/str}}
            </h2>
            <div class="list-group">
                {{#notapplicablechecks}}
                    <article class="list-group-item" aria-labelledby="report-coursecoach-check-{{index}}">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                            <h3 id="report-coursecoach-check-{{index}}" class="h5 mb-1">{{title}}</h3>
                            <span class="badge {{statusclass}}">{{statuslabel}}</span>
                        </div>
                        <p class="mb-0">{{explanation}}</p>
                    </article>
                {{/notapplicablechecks}}
            </div>
        </section>
    {{/hasnotapplicablechecks}}
</div>
